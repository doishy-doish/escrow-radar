    "title": "Escrow-Bounty Radar",
    "version": "1.3.0",
    "contact": {
      "name": "Escrow-Bounty Radar",
      "email": "10a11andralemisquitta@gmail.com"
    },
    "description": "Pay-per-call datasets for agents on Base (USDC, no key): bounty board, token prices, gas quotes, AI papers. All endpoints accept GET and POST; filters may be sent as query parameters or as a JSON body. Unpaid requests return a 402 x402-v2 payment challenge (also in the payment-required response header); paid requests return the dataset."
  },
  "servers": [
    {
      "url": "https://escrow-radar.vercel.app"
    }
  ],
  "paths": {
    "/api/feed": {
      "get": {
        "operationId": "listBounties",
        "summary": "Live escrow-bounty radar feed",
        "security": [],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Max items to return, 1-50 (default all)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50,
                    "description": "Max items to return, 1-50 (default all)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Live escrow-bounty radar feed result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "stream": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      },
                      "content": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "stream",
                      "title",
                      "url"
                    ]
                  }
                }
              }
            }
          },
          "402": {
            "description": "Payment required"
          }
        },
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.01"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        }
      },
